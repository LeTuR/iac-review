{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:openssf-scorecard",
    ":semanticCommits",
    ":rebaseStalePrs"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "5 days",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "github-actions": { "pinDigests": true },
  "vulnerabilityAlerts": { "minimumReleaseAge": null, "labels": ["security"] },
  "packageRules": [
    {
      "description": "Development tooling moves together and is low risk.",
      "matchDepTypes": ["dev"],
      "groupName": "dev tooling"
    },
    {
      "description": "Keep the pre-commit hook pins in step with the pinned tools.",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    }
  ]
}
